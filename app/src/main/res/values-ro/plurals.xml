<?xml version="1.0" encoding="utf-8"?>
<!--
  Setul complet de forme românești: one (1), few (0 și 2–19), other (20+, care cere "de").
  Ex: 1 task, 3 task-uri, 20 de task-uri.
-->
<resources>
    <plurals name="stats_total_completions">
        <item quantity="one">Total task-uri finalizate vreodată: %1$d</item>
        <item quantity="few">Total task-uri finalizate vreodată: %1$d</item>
        <item quantity="other">Total task-uri finalizate vreodată: %1$d</item>
    </plurals>

    <plurals name="stats_active_tasks">
        <item quantity="one">Task-uri urmărite în prezent: %1$d</item>
        <item quantity="few">Task-uri urmărite în prezent: %1$d</item>
        <item quantity="other">Task-uri urmărite în prezent: %1$d</item>
    </plurals>

    <plurals name="stats_today">
        <item quantity="one">Azi: %1$d task finalizat</item>
        <item quantity="few">Azi: %1$d task-uri finalizate</item>
        <item quantity="other">Azi: %1$d de task-uri finalizate</item>
