<?xml version="1.0" encoding="utf-8"?>
<!--
  Forme de plural pentru textele cu numărători.

  Aici (values/, fără calificator de limbă) folosim doar `one` și `other`, pentru că
  regulile de plural aplicate sunt cele ale limbii dispozitivului: pe un telefon
  setat pe engleză există doar aceste două categorii, iar `few` nu ar fi niciodată
  ales. Forma `other` este de aceea cea uzuală ("2 task-uri"), nu cea cu "de".

  În values-ro/ există setul complet one / few / other, cu "de" pentru 20+,
  conform regulilor românești.
-->
<resources>
    <plurals name="stats_total_completions">
        <item quantity="one">Total task-uri finalizate vreodată: %1$d</item>
        <item quantity="other">Total task-uri finalizate vreodată: %1$d</item>
    </plurals>

    <plurals name="stats_active_tasks">
        <item quantity="one">Task-uri urmărite în prezent: %1$d</item>
        <item quantity="other">Task-uri urmărite în prezent: %1$d</item>
    </plurals>

    <plurals name="stats_today">
        <item quantity="one">Azi: %1$d task finalizat</item>
        <item quantity="other">Azi: %1$d task-uri finalizate</item>
    </plurals>

    <plurals name="stats_yesterday">
        <item quantity="one">Ieri: %1$d task finalizat</item>
        <item quantity="other">Ieri: %1$d task-uri finalizate</item>
    </plurals>

    <plurals name="stats_this_month">
        <item quantity="one">Luna aceasta: %1$d task finalizat</item>
        <item quantity="other">Luna aceasta: %1$d task-uri finalizate</item>
    </plurals>

    <plurals name="stats_alltime_row">
        <item quantity="one">📌 %1$s: %2$d finalizare</item>
        <item quantity="other">📌 %1$s: %2$d finalizări</item>
    </plurals>

    <plurals name="stats_streak_row">
        <item quantity="one">🔥 %1$d zi — %2$s (record: %3$d)</item>
        <item quantity="other">🔥 %1$d zile — %2$s (record: %3$d)</item>
    </plurals>

    <plurals name="detail_every_n_days">
        <item quantity="one">Zilnic (Reset %2$s)</item>
        <item quantity="other">La %1$d zile (Reset %2$s)</item>
    </plurals>
</resources>
