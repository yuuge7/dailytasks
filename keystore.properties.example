# Copy this file to `keystore.properties` and fill in your own values.
#
# `keystore.properties` and every `*.jks` file are git-ignored on purpose:
# the signing key must never reach the repository.
#
# Without this file the project still builds — `assembleDebug` works out of the
# box, and `assembleRelease` simply produces an unsigned APK.

storeFile=dailyfocus-release.jks
storePassword=your-keystore-password
keyAlias=dailyfocus
keyPassword=your-key-password
